# Environment variables for Sourced RAG Document Q&A
# Copy this file to `.env` at the repo root and fill in real values.
# Never commit `.env` — it contains secrets.

# Supabase / Postgres connection string for SQLAlchemy.
# Use the postgresql+psycopg2:// scheme, e.g.:
# DATABASE_URL=postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=

# Comma-separated browser origins allowed by CORS (Vite default on Day 7).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application display name (optional).
APP_NAME=Sourced RAG Document Q&A

# JWT settings — used from Day 2 onward. Generate a long random SECRET_KEY.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Day 3 — PDF uploads (relative to repo root unless absolute)
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=20971520
# Section-aware chunking: word windows that span pages within a section.
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Day 4 — embeddings (384 dims; must match Vector(384) on document_chunks)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# BGE query instruction (prepended to search queries, not to passages).
EMBEDDING_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages: 

# Day 5 — OpenAI LLM (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RAG_TOP_K=5

# Standard retrieve -> fuse -> rerank pipeline
RAG_DENSE_K=30
RAG_SPARSE_K=30
RAG_RRF_K=60
RAG_CANDIDATE_K=40
RAG_CONTEXT_K=12
RAG_NEIGHBOR_WINDOW=1
RAG_NEIGHBOR_CAP=18
RAG_TOC_PENALTY=0.3
RAG_QUERY_REWRITES=3
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# Bump to invalidate cached answers when retrieval changes.
RAG_PIPELINE_VERSION=3

# Day 6 — Redis (Upstash: https://console.upstash.com → Redis → REST/URL → Redis URL)
REDIS_URL=
RATE_LIMIT_PER_HOUR=20
ANSWER_CACHE_TTL=3600
EMBED_CACHE_TTL=86400
