# Environment variables for Sourced RAG Document Q&A
# Copy this file to `.env` at the repo root and fill in real values.
# Never commit `.env` — it contains secrets.

# Supabase / Postgres connection string for SQLAlchemy.
# Use the postgresql+psycopg2:// scheme, e.g.:
# DATABASE_URL=postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=

# Comma-separated browser origins allowed by CORS (Vite default on Day 7).
ALLOWED_ORIGINS=http://localhost:5173

# Application display name (optional).
APP_NAME=Sourced RAG Document Q&A

# JWT settings — used from Day 2 onward. Generate a long random SECRET_KEY.
SECRET_KEY=
ALGORITHM=HS256
